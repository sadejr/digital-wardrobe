@model List<DigitalWardrobe.Core.Entities.ClothingItem>
@{
    ViewData["Title"] = "My wardrobe";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My wardrobe</h1>
    <a class="btn btn-primary" asp-action="Create">Add item</a>
</div>

@if (Model.Count == 0)
{
    <p>Your wardrobe is empty. Add your first item.</p>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100">
                    @if (item.ImageKey != null)
                    {
                        <img src="@Url.Action("Photo", new { id = item.Id, v = item.UpdatedAt.Ticks })"
                             class="card-img-top wardrobe-photo" alt="@item.Name" loading="lazy" />
                    }
                    else
                    {
                        <div class="card-img-top wardrobe-photo d-flex align-items-center justify-content-center bg-light text-muted">
                            No photo
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-action="Details" asp-route-id="@item.Id" class="stretched-link text-decoration-none">@item.Name</a>
                        </h5>
                        @if (item.Brand != null)
                        {
                            <p class="card-text text-muted mb-1">@item.Brand</p>
                        }
                        @if (item.Category != null)
                        {
                            <span class="badge bg-secondary">@item.Category</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}