{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Registration": {
    "Enabled": false
  },
  "Limits": {
    "MaxItemsPerUser": 1000,
    "MaxTagsPerUser": 100
  },
  "Storage": {
    "PhotosPath": "photos"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}